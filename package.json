{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/orbit",
    "dev:voyager": "npm run dev -w apps/voyager",
    "build": "npm run build -w apps/orbit",
    "build:voyager": "npm run build -w apps/voyager",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check -w apps/orbit"
  }
}
