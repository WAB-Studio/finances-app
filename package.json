{
  "name": "monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/finances",
    "dev:reading": "npm run dev -w apps/reading",
    "build": "npm run build -w apps/finances",
    "build:reading": "npm run build -w apps/reading",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run check -w apps/finances"
  }
}
