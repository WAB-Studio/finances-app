{
  "name": "voyager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3100}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "typecheck": "tsgo --noEmit",
    "dict:build": "node --import tsx scripts/build-dictionary.ts",
    "check:dict": "node --import tsx scripts/check-dictionary.ts",
    "check:e2e": "node ../../node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fast-xml-parser": "^5.11.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
